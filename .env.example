# Gemini API - obtén tu clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Base de datos PostgreSQL (Neon - gratis en https://neon.tech)
# Pega aquí la "Connection string" de Neon (formato pooled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# URL directa (sin pooling) — también de Neon
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
